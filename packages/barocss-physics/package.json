{
  "name": "@barocss/physics",
  "version": "0.0.0-experimental",
  "private": false,
  "type": "module",
  "description": "Bounded renderer-neutral fixed-step 3D sphere dynamics",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cad-proxy": {
      "types": "./dist/cad-proxy.d.ts",
      "import": "./dist/cad-proxy.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build:library": "tsc && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js"
  },
  "dependencies": {
    "@barocss/cad": "workspace:*"
  },
  "publishConfig": { "access": "public" }
}
