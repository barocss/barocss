     ],
     [
      "#1038",
      "Mia Chen",
      "2026-09-21",
      "$312.75",
      "Pending"
     ]
    ]
   }
  },
  "badge_row": {
   "type": "Stack",
   "props": {
    "className": "flex flex-row flex-wrap items-center gap-2"
   },
   "children": [
    "badge_paid",
    "badge_pending",
    "badge_refunded"
   ]
  },
  "badge_paid": {
   "type": "Badge",
   "props": {
    "text": "Paid · 2",
    "variant": "default"
   }
  },
  "badge_pending": {
   "type": "Badge",
   "props": {
    "text": "Pending · 2",
    "variant": "secondary"
   }
  },
  "badge_refunded": {
   "type": "Badge",
   "props": {
    "text": "Refunded · 1",
    "variant": "destructive"
   }
  },
  "footer_separator": {
   "type": "Separator",
   "props": {}
  },
  "footer_stack": {
   "type": "Stack",
   "props": {
    "className": "flex flex-row items-center justify-between pt-4 text-muted-foreground"
   },
   "children": [
    "footer_count",
    "footer_total"
   ]
  },
  "footer_count": {
   "type": "Text",
   "props": {
    "text": "Showing 5 of 128 orders",
    "variant": "muted"
