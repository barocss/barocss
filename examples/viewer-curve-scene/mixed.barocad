@model native_mixed {version:0;length-unit:mm;@surface #left_patch {type:nurbs;degree-u:1;degree-v:1;knots-u:[0,0,1,1];knots-v:[0,0,1,1];control-points:[[[-1000,-450,0],[-1000,450,0]],[[-50,-450,0],[-50,450,0]]];weights:[[1,1],[1,1]];}@surface #right_patch {type:nurbs;degree-u:1;degree-v:1;knots-u:[0,0,1,1];knots-v:[0,0,1,1];control-points:[[[50,-450,0],[50,450,0]],[[1000,-450,0],[1000,450,0]]];weights:[[1,1],[1,1]];}@curve #weighted_left {type:nurbs;degree:2;knots:[-2,-2,-2,7,7,7];control-points:[[-850,-200,100],[-550,400,100],[-150,-100,100]];weights:[1,1.4,1];}@curve #weighted_right {type:nurbs;degree:2;knots:[-2,-2,-2,7,7,7];control-points:[[150,-100,120],[500,450,170],[850,-200,120]];weights:[1,0.7,1.2];}}