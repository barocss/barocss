{
  "name": "@barocss/cad-interop",
  "version": "0.0.0-experimental",
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "description": "BaroCSS CAD preview export and native source loaders",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./boolean-extrusion-feature-graph": {
      "types": "./dist/boolean-extrusion-feature-graph.d.ts",
      "import": "./dist/boolean-extrusion-feature-graph.js"
    },
    "./assembly": {
      "types": "./dist/assembly.d.ts",
      "import": "./dist/assembly.js"
    },
    "./document-glb": {
      "types": "./dist/document-glb.d.ts",
      "import": "./dist/document-glb.js"
    },
    "./boolean-mesh-glb": {
      "types": "./dist/boolean-mesh-glb.d.ts",
      "import": "./dist/boolean-mesh-glb.js"
    },
    "./boolean-extrusion-glb": {
      "types": "./dist/boolean-extrusion-glb.d.ts",
      "import": "./dist/boolean-extrusion-glb.js"
    },
    "./three-document": {
      "types": "./dist/three-document.d.ts",
      "import": "./dist/three-document.js"
    },
    "./three-assembly": {
      "types": "./dist/three-assembly.d.ts",
      "import": "./dist/three-assembly.js"
    },
    "./three-boolean-contours": {
      "types": "./dist/three-boolean-contours.d.ts",
      "import": "./dist/three-boolean-contours.js"
    },
    "./three-boolean-mesh": {
      "types": "./dist/three-boolean-mesh.d.ts",
      "import": "./dist/three-boolean-mesh.js"
    },
    "./three-boolean-extrusion-mesh": {
      "types": "./dist/three-boolean-extrusion-mesh.d.ts",
      "import": "./dist/three-boolean-extrusion-mesh.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./babylon": {
      "types": "./dist/babylon.d.ts",
      "import": "./dist/babylon.js"
    },
    "./babylon-document": {
      "types": "./dist/babylon-document.d.ts",
      "import": "./dist/babylon-document.js"
    },
    "./babylon-assembly": {
      "types": "./dist/babylon-assembly.d.ts",
      "import": "./dist/babylon-assembly.js"
    },
    "./babylon-boolean-mesh": {
      "types": "./dist/babylon-boolean-mesh.d.ts",
      "import": "./dist/babylon-boolean-mesh.js"
    },
    "./babylon-boolean-extrusion-mesh": {
      "types": "./dist/babylon-boolean-extrusion-mesh.d.ts",
      "import": "./dist/babylon-boolean-extrusion-mesh.js"
    },
    "./pixi3d": {
      "types": "./dist/pixi3d.d.ts",
      "import": "./dist/pixi3d.js"
    },
    "./pixi3d-document": {
      "types": "./dist/pixi3d-document.d.ts",
      "import": "./dist/pixi3d-document.js"
    },
    "./pixi3d-assembly": {
      "types": "./dist/pixi3d-assembly.d.ts",
      "import": "./dist/pixi3d-assembly.js"
    },
    "./pixi3d-boolean-mesh": {
      "types": "./dist/pixi3d-boolean-mesh.d.ts",
      "import": "./dist/pixi3d-boolean-mesh.js"
    },
    "./model-set": {
      "types": "./dist/model-set.d.ts",
      "import": "./dist/model-set.js"
    }
  },
  "files": ["dist", "examples", "README.md", "LICENSE"],
  "scripts": {
    "build:library": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm build:library && node --test test/interop.test.mjs",
    "test:native": "pnpm --filter @barocss/cad build:library && pnpm build:library && node test/native-loader.test.mjs",
    "test:babylon": "pnpm --filter @barocss/cad build:library && pnpm build:library && node test/babylon-loader.test.mjs",
    "test:curve": "node test/curve-loader.test.mjs",
    "test:abortable": "node test/abortable-loader.test.mjs",
    "test:integration": "pnpm --filter @barocss/cad build:library && pnpm --filter @barocss/gpu build:library && pnpm build:library && node --test test/cad-integration.test.mjs"
  },
  "dependencies": {
    "@barocss/cad": "workspace:*"
  },
  "peerDependencies": {
    "@babylonjs/core": "9.29.0",
    "three": "^0.186.1",
    "pixi.js": "7.2.4",
    "pixi3d": "2.5.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": { "optional": true },
    "three": { "optional": true },
    "pixi.js": { "optional": true },
    "pixi3d": { "optional": true }
  },
  "devDependencies": {
    "@babylonjs/core": "9.29.0",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "pixi.js": "7.2.4",
    "pixi3d": "2.5.0"
  }
}
