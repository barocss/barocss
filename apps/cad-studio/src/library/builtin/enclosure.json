  {
   "id": "snap-hook",
   "name": "Cantilever snap hook",
   "category": "enclosure",
   "description": "A cantilever, straight or tapered, with a hook at its tip, standing on a wall: its strain and forces on assembly checked against the body's material.",
   "parameters": {
    "L": {
     "value": 12,
     "unit": "mm",
     "min": 2,
     "max": 100,
     "source": "free: the beam's length, root to the hook"
    },
    "t": {
     "value": 1.5,
     "unit": "mm",
     "min": 0.4,
     "max": 10,
     "source": "free: the beam's thickness at its root (in the bending direction)"
    },
    "r": {
     "value": 1,
     "unit": "ratio",
     "min": 0.4,
     "max": 1,
     "source": "free: the tip's thickness over the root's (1: a uniform beam)"
    },
    "b": {
     "value": 6,
     "unit": "mm",
     "min": 1,
     "max": 60,
     "source": "free: the beam's width"
    },
    "y": {
     "value": 1.0,
     "unit": "mm",
     "min": 0.1,
     "max": 10,
     "source": "free: the hook's undercut — the deflection on assembly"
    },
    "hh": {
     "value": 2.0,
     "unit": "mm",
     "estimate": true,
     "source": "BaroCSS starting proportion for a printed or moulded snap hook (written for this library); size it by its strain check",
     "description": "the hook's height"
    },
    "ar": {
     "value": 90,
     "unit": "deg",
     "min": 20,
     "max": 90,
     "source": "free: the retaining face's angle from the push-on direction (90: square, it does not let go)"
    },
    "tt": {
     "value": {
      "expr": "r * t"
     },
     "unit": "mm",
     "description": "the beam's thickness at the hook"
    },
    "ry": {
     "value": {
      "expr": "y / tan(ar)"
     },
     "unit": "mm",
     "description": "how far the retaining face rises across the undercut"
    },
    "alpha": {
     "value": {
      "expr": "atan(y / (hh - ry))"
     },
     "unit": "deg",
     "description": "the lead (push-on) face's angle from the push-on direction"
    },
    "F": {
     "value": {
      "expr": "r >= 0.999 ? 1 / 3 : (0 - ln(r) + 2 * r - r ^ 2 / 2 - 1.5) / (1 - r) ^ 3"
     },
     "description": "BaroCSS derivation (written here, D68): a cantilever whose thickness falls linearly from t at the root to r·t at the tip, a load at the tip; by Euler–Bernoulli, y = 12 P L³ F(r) / (E b t³) with F(r) = ∫₀¹ s² / (r + (1 − r) s)³ ds = (−ln r + 2r − r²/2 − 3/2) / (1 − r)³ (1/3 when r = 1), and the root strain ε = 6 P L / (E b t²) = (1 / (3 F(r))) · 1.5 t y / L²"
    },
    "eps": {
     "value": {
      "expr": "1.5 * t * y / L ^ 2 / (3 * F)"
     },
     "unit": "ratio",
     "description": "the root strain on assembly (tapered beams corrected, D68)"
    }
   },
   "context": {
    "epsAllow": {
     "unit": "ratio",
     "description": "the material's allowable strain",
     "from": [
      "material.allowableStrain"
     ]
    },
    "E": {
     "unit": "MPa",
     "description": "the material's elastic modulus",
     "from": [
      "material.elasticModulusMPa"
     ]
    },
    "ys": {
     "unit": "MPa",
     "description": "the material's yield strength",
     "from": [
      "material.yieldMPa"
     ]
    },
    "mu": {
     "unit": "ratio",
     "description": "the coefficient of friction (the material's, an estimate, or given)",
     "from": [
      "material.friction",
      "given"
     ]
    },
    "isFdm": {
     "unit": "flag",
