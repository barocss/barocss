     "value": "hh - ry",
     "level": "feasible",
     "message": "the hook is too short for its retaining face's rise"
    },
    {
     "id": "strain",
     "expr": "eps <= epsAllow",
     "value": "eps / epsAllow",
     "level": "recommended",
     "message": "the beam is strained past the material's allowable strain on assembly"
    },
    {
     "id": "yield",
     "expr": "eps <= ys / E",
     "value": "eps / (ys / E)",
     "level": "feasible",
     "message": "the beam would yield on assembly (ε past σy/E)"
    },
    {
     "id": "lead-locks",
     "expr": "1 - mu * tan(alpha) > 0",
