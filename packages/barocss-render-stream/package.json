{
  "name": "@barocss/render-stream",
  "version": "0.12.0",
  "type": "module",
  "description": "Bounded validated screen snapshot compilation and Fetch streaming",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss.git",
    "directory": "packages/barocss-render-stream"
  },
  "homepage": "https://barocss.com",
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
