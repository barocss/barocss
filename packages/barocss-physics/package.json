{
  "name": "@barocss/physics",
  "version": "0.0.0-experimental",
  "private": false,
  "type": "module",
  "description": "Bounded renderer-neutral fixed-step 3D rigid, visual-water and cloth simulation",
  "license": "MIT",
  "exports": {
    ".": {
      "barocss-source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./cad-proxy": {
      "barocss-source": "./src/cad-proxy.ts",
      "types": "./src/cad-proxy.ts",
      "import": "./src/cad-proxy.ts"
    },
    "./replay": {
      "barocss-source": "./src/replay.ts",
      "types": "./src/replay.ts",
      "import": "./src/replay.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:library": "node src/generate-provider.mjs && node build-types.mjs && node build-root.mjs && node src/generate-provider.mjs --emitted"
  },
  "dependencies": {
    "@barocss/cad": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "barocss-source": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./cad-proxy": {
        "barocss-source": "./dist/cad-proxy.js",
        "types": "./dist/cad-proxy.d.ts",
        "import": "./dist/cad-proxy.js"
      },
      "./replay": {
        "barocss-source": "./dist/replay.js",
        "types": "./dist/replay.d.ts",
        "import": "./dist/replay.js"
      }
    }
  }
}
