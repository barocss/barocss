{
  "name": "@barocss/kit",
  "version": "0.10.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barocss/barocss.git",
    "directory": "packages/barocss"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme/default": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./theme/default": {
        "import": {
          "types": "./dist/theme/default.d.ts",
          "default": "./dist/theme/default.js"
        },
        "require": {
          "types": "./dist/theme/default.d.cts",
          "default": "./dist/theme/default.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "build:library": "pnpm run build",
    "test:watch": "vitest",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "tailwindcss-4-1": "npm:tailwindcss@4.1.13",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.2"
  }
}
