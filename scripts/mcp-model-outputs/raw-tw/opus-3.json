{"type":"result","subtype":"success","is_error":false,"api_error_status":null,"duration_ms":33063,"duration_api_ms":31308,"ttft_ms":2609,"ttft_stream_ms":1720,"time_to_request_ms":33,"num_turns":1,"result":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Booking</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script>\n  tailwind.config = {\n    theme: {\n      extend: {\n        colors: { brand: { 500: '#4f46e5', 600: '#4338ca', 700: '#3730a3' } }\n      }\n    }\n  }\n</script>\n</head>\n<body class=\"bg-slate-100 text-slate-800 antialiased\">\n  <div class=\"min-h-screen flex items-center justify-center p-4\">\n    <div class=\"w-full max-w-lg bg-white rounded-2xl shadow-xl ring-1 ring-slate-200 overflow-hidden\">\n      <!-- Header -->\n      <div class=\"bg-gradient-to-r from-brand-600 to-brand-500 px-6 py-5\">\n        <h1 class=\"text-xl font-semibold text-white\">Reserve your table</h1>\n        <p class=\"text-sm text-indigo-100 mt-0.5\">The Copper Fork · Downtown</p>\n      </div>\n\n      <!-- Form -->\n      <form id=\"bookingForm\" class=\"px-6 py-6 space-y-5\" novalidate>\n        <div>\n          <label for=\"name\" class=\"block text-sm font-medium text-slate-700 mb-1\">Full name</label>\n          <input id=\"name\" name=\"name\" type=\"text\" autocomplete=\"name\" required\n            class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none\"\n            placeholder=\"Jane Doe\">\n          <p class=\"hidden mt-1 text-xs text-rose-600\" data-error-for=\"name\">Please enter your name.</p>\n        </div>\n\n        <div>\n          <label for=\"email\" class=\"block text-sm font-medium text-slate-700 mb-1\">Email</label>\n          <input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\" required\n            class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none\"\n            placeholder=\"jane@example.com\">\n          <p class=\"hidden mt-1 text-xs text-rose-600\" data-error-for=\"email\">Enter a valid email address.</p>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-4\">\n          <div>\n            <label for=\"date\" class=\"block text-sm font-medium text-slate-700 mb-1\">Date</label>\n            <input id=\"date\" name=\"date\" type=\"date\" required\n              class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none\">\n            <p class=\"hidden mt-1 text-xs text-rose-600\" data-error-for=\"date\">Choose a date.</p>\n          </div>\n          <div>\n            <label for=\"time\" class=\"block text-sm font-medium text-slate-700 mb-1\">Time</label>\n            <input id=\"time\" name=\"time\" type=\"time\" required\n              class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none\">\n            <p class=\"hidden mt-1 text-xs text-rose-600\" data-error-for=\"time\">Choose a time.</p>\n          </div>\n        </div>\n\n        <div>\n          <label for=\"party\" class=\"block text-sm font-medium text-slate-700 mb-1\">Party size</label>\n          <select id=\"party\" name=\"party\" required\n            class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none\">\n            <option value=\"\">Select…</option>\n            <option value=\"1\">1 guest</option>\n            <option value=\"2\">2 guests</option>\n            <option value=\"3\">3 guests</option>\n            <option value=\"4\">4 guests</option>\n            <option value=\"5\">5 guests</option>\n            <option value=\"6\">6 guests</option>\n            <option value=\"7+\">7+ guests</option>\n          </select>\n          <p class=\"hidden mt-1 text-xs text-rose-600\" data-error-for=\"party\">Select a party size.</p>\n        </div>\n\n        <div>\n          <label for=\"notes\" class=\"block text-sm font-medium text-slate-700 mb-1\">Special requests <span class=\"text-slate-400 font-normal\">(optional)</span></label>\n          <textarea id=\"notes\" name=\"notes\" rows=\"3\"\n            class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm resize-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none\"\n            placeholder=\"Allergies, seating preferences, celebrations…\"></textarea>\n        </div>\n\n        <div class=\"pt-1 flex items-center gap-3\">\n          <button type=\"submit\"\n            class=\"inline-flex items-center justify-center rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500/40 transition\">\n            Confirm booking\n          </button>\n          <span id=\"status\" class=\"text-sm text-slate-500\" aria-live=\"polite\"></span>\n        </div>\n      </form>\n\n      <!-- Success -->\n      <div id=\"success\" class=\"hidden px-6 py-10 text-center\">\n        <div class=\"mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100\">\n          <svg class=\"h-6 w-6 text-emerald-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4.5 12.75l6 6 9-13.5\" />\n          </svg>\n        </div>\n        <h2 class=\"mt-4 text-lg font-semibold text-slate-900\">Booking confirmed</h2>\n        <p id=\"successDetail\" class=\"mt-1 text-sm text-slate-500\"></p>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function () {\n      const form = document.getElementById('bookingForm');\n      const statusEl = document.getElementById('status');\n\n      // Set date min to today\n      const dateInput = document.getElementById('date');\n      const today = new Date().toISOString().split('T')[0];\n      dateInput.min = today;\n\n      function showError(name, show) {\n        const msg = form.querySelector(`[data-error-for=\"${name}\"]`);\n        const field = form.elements[name];\n        if (msg) msg.classList.toggle('hidden', !show);\n        if (field) {\n          field.classList.toggle('border-rose-400', show);\n          field.classList.toggle('border-slate-300', !show);\n        }\n      }\n\n      function validate() {\n        let ok = true;\n        const checks = {\n          name: v => v.trim().length > 0,\n          email: v => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v),\n          date: v => !!v,\n          time: v => !!v,\n          party: v => !!v\n        };\n        for (const field in checks) {\n          const valid = checks[field](form.elements[field].value);\n          showError(field, !valid);\n          if (!valid) ok = false;\n        }\n        return ok;\n      }\n\n      form.addEventListener('input', e => {\n        if (e.target.name) showError(e.target.name, false);\n        statusEl.textContent = '';\n      });\n\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        if (!validate()) {\n          statusEl.textContent = 'Please fix the highlighted fields.';\n          statusEl.className = 'text-sm text-rose-600';\n          return;\n        }\n\n        const data = Object.fromEntries(new FormData(form).entries());\n\n        // Notify the host MCP app, if listening.\n        try {\n          window.parent.postMessage({ type: 'mcp:tool-result', tool: 'booking', payload: data }, '*');\n        } catch (_) {}\n\n        const dt = new Date(data.date + 'T' + data.time);\n        const pretty = isNaN(dt) ? (data.date + ' ' + data.time)\n          : dt.toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n\n        document.getElementById('successDetail').textContent =\n          `Table for ${data.party} on ${pretty}. A confirmation was sent to ${data.email}.`;\n\n        form.classList.add('hidden');\n        document.getElementById('success').classList.remove('hidden');\n      });\n    })();\n  </script>\n</body>\n</html>","stop_reason":"end_turn","session_id":"37cd13cf-5a01-4ccb-90e5-cdf8ad7331c1","total_cost_usd":0.08470399999999999,"usage":{"input_tokens":2,"cache_creation_input_tokens":255,"cache_read_input_tokens":1888,"output_tokens":3248,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":255,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3248,"cache_read_input_tokens":1888,"cache_creation_input_tokens":255,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":255},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-4-8":{"inputTokens":2,"outputTokens":3248,"cacheReadInputTokens":1888,"cacheCreationInputTokens":255,"webSearchRequests":0,"costUSD":0.08470399999999999,"contextWindow":1000000,"maxOutputTokens":64000}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","uuid":"4cd9abcb-e5c9-4eb8-8c35-57e83b5c51cd"}
