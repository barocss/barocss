{
  "name": "@barocss/render",
  "version": "0.12.2",
  "type": "module",
  "peerDependencies": {
    "react": "19.2.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
