{
  "name": "@barocss/cad-editor",
  "version": "0.0.0-experimental",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Native CAD authoring sessions and reusable React viewport and inspector",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.tsx",
      "import": "./src/react/index.tsx"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "./styles.css": "./dist/cad-editor.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:library": "node scripts/build.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/modeling-file-test.mjs && node scripts/feature-preview-epoch-test.mjs && node scripts/feature-preview-lifecycle-test.mjs && node scripts/feature-preview-advisory-test.mjs && node scripts/modeling-pocket-recipes-test.mjs"
  },
  "dependencies": {
    "@barocss/cad": "workspace:*",
    "@barocss/viewer": "workspace:*",
    "@barocss/cad-interop": "workspace:*",
    "radix-ui": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.52.0",
    "@barocss/gpu": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "8.3.1",
    "esbuild": "0.28.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.4"
  }
}
