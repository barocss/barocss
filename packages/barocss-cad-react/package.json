{
  "name": "@barocss/cad-react",
  "version": "0.0.0-experimental",
  "private": true,
  "type": "module",
  "description": "Experimental compositional CAD React host using the existing CAD model and Viewer",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "import": "./src/engine.ts"
    },
    "./viewer": {
      "types": "./src/viewer.ts",
      "import": "./src/viewer.ts"
    }
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "dependencies": {
    "@barocss/cad-model": "workspace:*",
    "@barocss/viewer": "workspace:*"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "lint": "eslint src tests examples"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
