@model curve_display_demo {
  version: 0;
  length-unit: mm;

  @curve #weighted_quarter {
    type: nurbs;
    degree: 2;
    knots: [0,0,0,1,1,1];
    control-points: [[100,0,0],[100,100,0],[0,100,0]];
    weights: [1,0.7071067811865476,1];
  }

  @curve #asymmetric_nonunit {
    type: nurbs;
    degree: 3;
    knots: [-1,-1,-1,-1,2,2,2,2];
    control-points: [[-40,0,20],[-20,70,15],[30,-20,15],[70,40,20]];
    weights: [1,2,0.75,1.25];
  }

  @surface #base_panel {
    type: nurbs;
    degree-u: 1;
    degree-v: 1;
    knots-u: [0,0,1,1];
    knots-v: [0,0,1,1];
    control-points: [[[-40,-30,-10],[-40,-30,30]],[[100,-30,-10],[100,-30,30]]];
    weights: [[1,1],[1,1]];
  }
}
