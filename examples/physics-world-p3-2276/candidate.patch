diff --git a/packages/barocss-physics/src/disjoint-hinge/admission.ts b/packages/barocss-physics/src/disjoint-hinge/admission.ts
new file mode 100644
--- /dev/null
+++ b/packages/barocss-physics/src/disjoint-hinge/admission.ts
@@ -0,0 +1,60 @@
+import type { PhysicsModel, WorldOptions } from '../types.js';
+import type { Body, Joint } from '../internal-types.js';
+import { parseJoints } from '../joints.js';
+import { error } from '../validation.js';
+import type { ParsedPair } from './types.js';
+
+const RESTRICTION = 'dynamic pair supports one joint between two dynamic spheres';
+const equal = (values: readonly number[], wanted: readonly number[]): boolean =>
+  values.length === wanted.length && values.every((value, index) => value === wanted[index]);
+const refuse = (): never => error('INVALID_CONFIG', RESTRICTION);
+
+/** Parsed model data only. All other existing profiles retain their original parser. */
+export function parseDisjointHingeProfile(model: PhysicsModel, options: WorldOptions,
+  inputs: readonly Record<string, unknown>[], bodies: Body[]): {
+    joints: Joint[]; pairs: [ParsedPair, ParsedPair];
+  } | null {
+  if (bodies.length !== 4 || bodies.some(body => body.kind !== 'dynamic') ||
+    inputs.length !== 2 || inputs.some(input => input.kind !== 'hinge')) return null;
+  const byId = new Map(bodies.map((body, index) => [body.id, { body, index }]));
+  const seenB = new Set<string>();
+  // Parse in submitted joint order before testing the narrower physical profile.
+  const joints = inputs.map(input => {
+    const a = typeof input.aId === 'string' ? byId.get(input.aId) : undefined;
+    const b = typeof input.bId === 'string' ? byId.get(input.bId) : undefined;
+    if (!a || !b || a.index === b.index || seenB.has(b.body.id)) {
+      error('INVALID_CONFIG', 'joint needs a distinct A and unique dynamic B');
+    }
+    const local = parseJoints([input], [a.body, b.body])[0];
+    seenB.add(b.body.id);
+    return { ...local, aIndex: a.index, bIndex: b.index };
+  });
+  if (options.profile !== 'rigid-discrete-v1' || options.broadPhase !== 'direct' ||
+    options.fixedStepSeconds !== 1 / 120 || !equal(model.gravityMps2, [0, 0, 0]) ||
+    model.cloths.length !== 0 || model.fluids.length !== 0 ||
+    model.bodies.some(body => body.kind !== 'dynamic' || body.inertia.kind !== 'primitive-com')) refuse();
+  for (const body of bodies) {
+    if (body.shape.kind !== 'sphere' || body.shape.radiusM !== .1 || body.inverseMass !== 1 ||
+      body.inertiaKgM2 !== .4 * .1 ** 2 || body.restitution !== 0 ||
+      body.frictionStatic !== 1 || body.frictionDynamic !== .7 || body.sensor || body.ccd ||
+      body.collisionFilter || !equal(body.velocityMps, [0, 0, 0]) ||
+      !equal(body.angularVelocityRadps, [0, 0, 0]) || !equal(body.orientation, [0, 0, 0, 1])) refuse();
+  }
+  const used = new Set<number>();
+  const pairs: ParsedPair[] = joints.map((joint, jointInputIndex): ParsedPair => {
+    const a = bodies[joint.aIndex], b = bodies[joint.bIndex];
+    if (used.has(joint.aIndex) || used.has(joint.bIndex)) refuse();
+    used.add(joint.aIndex); used.add(joint.bIndex);
+    const z = a.positionM[2];
+    if ((z !== 0 && z !== 1) || !equal(a.positionM, [-.1, 0, z]) ||
+      !equal(b.positionM, [.1, 0, z]) || !equal(joint.anchorALocalM, [.1, 0, 0]) ||
+      !equal(joint.anchorBLocalM, [-.1, 0, 0]) || !equal(joint.axisWorld!, [0, 0, 1]) ||
+      !equal(joint.limitRad!, [-.8, .8]) || joint.motor?.targetSpeedRadps !== .5 ||
+      joint.motor.maxImpulseNms !== .0001 || joint.motor.maxReactionNms !== .01) refuse();
+    return { joint: { ...joint, aIndex: 0, bIndex: 1 }, originM: [0, 0, z],
+      bodyIndices: [joint.aIndex, joint.bIndex], jointInputIndex };
+  });
+  pairs.sort((a, b) => a.originM[2] - b.originM[2]);
+  if (used.size !== 4 || pairs[0].originM[2] !== 0 || pairs[1].originM[2] !== 1) refuse();
+  return { joints, pairs: pairs as [ParsedPair, ParsedPair] };
+}
diff --git a/packages/barocss-physics/src/disjoint-hinge/stage.ts b/packages/barocss-physics/src/disjoint-hinge/stage.ts
new file mode 100644
--- /dev/null
+++ b/packages/barocss-physics/src/disjoint-hinge/stage.ts
@@ -0,0 +1,48 @@
+import type { Body, PhysicsJointState } from '../internal-types.js';
+import type { AdmittedCommands } from '../validation.js';
+import { error } from '../validation.js';
+import { admitDynamicHingeCommands } from '../dynamic-hinge-joint.js';
+import { driveDynamicHingeMotor } from '../joint-motor.js';
+import { projectDisjointPostContact } from './postcontact.js';
+import type { ParsedPair } from './types.js';
+
+type Pairs = readonly [ParsedPair, ParsedPair];
+
+/** Generic parsing precedes this function. No physical stage runs on refusal. */
+export function admitDisjointHingeCommands(pairs: Pairs, bodies: Body[],
+  actions: Map<string, AdmittedCommands>, commandCount: number): void {
+  for (const pair of pairs) {
+    admitDynamicHingeCommands(pair.joint,
+      [bodies[pair.bodyIndices[0]], bodies[pair.bodyIndices[1]]], actions);
+  }
+  if (commandCount !== 0) error('INVALID_COMMAND', 'disjoint hinge profile supports empty commands only');
+}
+
+/** One motor per component, Z0 then Z1, using previous accepted report memory. */
+export function driveDisjointHingeMotors(pairs: Pairs, bodies: Body[],
+  reports: readonly PhysicsJointState[], impulses: number[]): void {
+  for (const pair of pairs) impulses[pair.jointInputIndex] = driveDynamicHingeMotor(pair.joint,
+    bodies[pair.bodyIndices[0]], bodies[pair.bodyIndices[1]], reports[pair.jointInputIndex].angleRad!);
+}
+
+/** Compose the qualified package phase; never repeat angular, motor, FREE or contact. */
+export function applyDisjointHingePostContact(pairs: Pairs, bodies: Body[],
+  reports: PhysicsJointState[], motorImpulses: readonly number[], sourceStepIndex: number,
+  sourceTimeSeconds: number): void {
+  // The unchanged helper checks caps in report index order. Give it canonical
+  // indices, then map its reports back to submitted order after both pairs pass.
+  const canonical: [ParsedPair, ParsedPair] = [
+    { ...pairs[0], jointInputIndex: 0 }, { ...pairs[1], jointInputIndex: 1 },
+  ];
+  const result = projectDisjointPostContact({ bodies, pairs: canonical,
+    motorImpulsesNms: [motorImpulses[pairs[0].jointInputIndex], motorImpulses[pairs[1].jointInputIndex]],
+    sourceStepIndex, sourceTimeSeconds });
+  for (let index = 0; index < bodies.length; index++) {
+    const target = bodies[index], returned = result.projectedBodies[index];
+    target.positionM = [...returned.positionM];
+    target.velocityMps = [...returned.velocityMps];
+    target.orientation = [...returned.orientation];
+    target.angularVelocityRadps = [...returned.angularVelocityRadps];
+  }
+  for (const index of [0, 1] as const) reports[pairs[index].jointInputIndex] = result.jointReports[index];
+}
