{
  "name": "@barocss/canvas2d",
  "version": "0.0.0-experimental",
  "private": false,
  "type": "module",
  "description": "Bounded retained WebGL2 canvas for logical-pixel 2D scenes",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./document": {
      "types": "./src/document.ts",
      "import": "./src/document.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build:library": "tsc && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./document": {
        "types": "./dist/document.d.ts",
        "import": "./dist/document.js"
      }
    }
  }
}
