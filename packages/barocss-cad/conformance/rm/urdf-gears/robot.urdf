<?xml version="1.0"?>
<!-- barocss-urdf-v1: barocss CAD Studio. SI units; each link's frame at its joint, Z on the axis; joint values 0 at the pose the mates solve to. -->
<robot name="robot">
  <link name="base">
    <inertial>
      <origin xyz="0.060070801748988656 0.030000000000000006 0.005" rpy="0 0 0"/>
      <mass value="0.19168566394729825"/>
      <inertia ixx="0.00005990652318868408" ixy="0" ixz="0" iyy="0.00023310124385572632" iyz="0" izz="0.0002898130059786221"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_collision.stl"/></geometry>
    </collision>
  </link>
  <link name="g1">
    <inertial>
      <origin xyz="0 0 0.0040000000000000036" rpy="0 0 0"/>
      <mass value="0.025398097768465883"/>
      <inertia ixx="0.0000028116379353752428" ixy="0" ixz="0" iyy="0.000002811637935375254" iyz="0" izz="0.000005352362827886857"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/g1.stl"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/g1_collision.stl"/></geometry>
    </collision>
  </link>
  <link name="g2">
    <inertial>
      <origin xyz="0 0 0.003999999999999996" rpy="0 0 0"/>
      <mass value="0.05916059495488091"/>
      <inertia ixx="0.000013895626132885098" ixy="0" ixz="0" iyy="0.000013895626132885084" iyz="0" izz="0.000027160205919584783"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/g2.stl"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/g2_collision.stl"/></geometry>
    </collision>
  </link>
  <joint name="base_to_g1" type="continuous">
    <parent link="base"/>
    <child link="g1"/>
    <origin xyz="0.03 0.03 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="base_to_g2" type="continuous">
    <parent link="base"/>
    <child link="g2"/>
    <origin xyz="0.08 0.03 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <mimic joint="base_to_g1" multiplier="-0.6666666666666666" offset="0"/>
  </joint>
</robot>
