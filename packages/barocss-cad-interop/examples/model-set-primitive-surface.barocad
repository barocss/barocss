@model wide_surface {
  version: 0;
  length-unit: mm;
  @surface #display_floor {
    type: nurbs;
    degree-u: 1;
    degree-v: 1;
    knots-u: [0,0,1,1];
    knots-v: [0,0,1,1];
    control-points: [[[-2,-6,-2],[-2,6,-2]],[[72,-6,-2],[72,6,-2]]];
    weights: [[1,1],[1,1]];
  }
  @surface #display_back {
    type: nurbs;
    degree-u: 1;
    degree-v: 1;
    knots-u: [0,0,1,1];
    knots-v: [0,0,1,1];
    control-points: [[[-2,6,-2],[-2,6,10]],[[72,6,-2],[72,6,10]]];
    weights: [[1,1],[1,1]];
  }
}
