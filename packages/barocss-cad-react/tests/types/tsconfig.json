{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "public-api.tsx",
    "../../examples/**/*.tsx",
    "revolve-api.tsx",
    "polygon-api.tsx",
    "profiles-api.tsx",
    "observation-api.tsx"
  ],
  "extends": "../../tsconfig.json"
}
