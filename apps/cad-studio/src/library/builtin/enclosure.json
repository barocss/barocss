  },
  {
   "id": "insert-hole",
   "name": "Heat-set insert hole",
   "category": "enclosure",
   "operation": "cut",
   "description": "The hole a brass heat-set insert is pressed into: cut from a boss or a wall at a point on its face.",
   "parameters": {
    "d": {
     "value": 3,
     "unit": "mm",
     "source": "the screw's nominal size (the variant's)",
     "description": "screw size"
    },
    "dh": {
     "value": 4.0,
     "unit": "mm",
     "estimate": true,
     "source": "written for this library as a typical brass heat-set insert for plastics (no supplier's table copied); use your insert's own datasheet",
     "description": "hole diameter"
    },
    "Lh": {
     "value": 5.0,
     "unit": "mm",
     "estimate": true,
     "source": "written for this library as a typical brass heat-set insert for plastics (no supplier's table copied); use your insert's own datasheet",
     "description": "hole depth"
    },
    "De": {
     "value": 4.6,
     "unit": "mm",
     "estimate": true,
     "source": "written for this library as a typical brass heat-set insert for plastics (no supplier's table copied); use your insert's own datasheet",
     "description": "the insert's outer diameter"
    }
   },
   "variants": [
    {
     "id": "M2",
     "values": {
      "d": 2,
      "dh": 3.2,
      "Lh": 4.0,
      "De": 3.6
     }
    },
    {
     "id": "M2.5",
     "values": {
      "d": 2.5,
      "dh": 3.6,
      "Lh": 4.6,
      "De": 4.0
     }
    },
    {
     "id": "M3",
     "values": {
      "d": 3,
      "dh": 4.0,
      "Lh": 5.0,
      "De": 4.6
     }
    },
    {
     "id": "M4",
     "values": {
      "d": 4,
      "dh": 5.6,
      "Lh": 6.6,
      "De": 6.3
     }
    },
    {
     "id": "M5",
     "values": {
      "d": 5,
      "dh": 6.4,
      "Lh": 7.5,
      "De": 7.1
     }
    }
   ],
   "context": {
    "depth": {
     "unit": "mm",
     "description": "the material under the point, along the hole",
     "from": [
      "measured",
      "given"
     ]
    },
    "around": {
     "unit": "mm",
     "description": "the least material round the hole's axis, halfway down",
     "from": [
      "measured",
      "given"
     ]
    }
   },
   "checks": [
    {
     "id": "breaks-through",
     "expr": "depth >= Lh + 0.4",
     "value": "depth - Lh",
     "level": "feasible",
     "message": "the hole would leave less than 0.4 mm under it, or break through"
    },
    {
     "id": "wall-round",
     "expr": "around - dh / 2 >= 0.8",
     "value": "around - dh / 2",
     "level": "feasible",
     "message": "less than 0.8 mm of material round the insert"
    },
    {
     "id": "boss-size",
     "expr": "around >= De",
     "value": "around / De",
     "level": "recommended",
     "message": "the boss round an insert should reach about twice its diameter across"
    }
   ],
   "recipe": [
    {
     "id": "s",
     "kind": "sketch",
     "profile": "circle",
     "center": [
      0,
      0
     ],
     "radius": {
      "expr": "dh / 2"
     }
    },
    {
     "id": "x",
     "kind": "extrude",
     "sketch": "s",
     "height": {
      "expr": "Lh + 1"
     },
     "from": -1
    }
   ],
   "interfaces": [
    {
     "id": "base",
     "role": "cut-base",
     "accepts": [
      "body-face"
     ],
     "frame": {
      "origin": [
       0,
       0,
       0
      ],
      "z": [
       0,
       0,
       1
      ],
      "x": [
       1,
       0,
       0
      ]
     },
     "description": "its mouth on the face, the hole going in along +z"
    },
    {
     "id": "insert",
     "role": "insert-axis",
     "accepts": [
      "screw"
     ],
     "frame": {
      "origin": [
       0,
       0,
       0
      ],
      "z": [
       0,
       0,
       -1
      ],
      "x": [
       1,
       0,
       0
      ]
     },
     "faces": {
      "axis": "x.side0"
     }
    }
   ],
   "tags": [
    "enclosure",
    "insert",
    "heat-set"
   ]
  },
  {
