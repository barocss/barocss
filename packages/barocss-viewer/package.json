{
  "name": "@barocss/viewer",
  "version": "0.0.0-experimental",
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "description": "Bounded native CAD Surface and Curve viewer using the BaroCSS GPU backend",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build:library": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@barocss/cad": "workspace:*",
    "@barocss/cad-interop": "workspace:*",
    "@barocss/gpu": "workspace:*",
    "@barocss/motion": "workspace:*"
  }
}
