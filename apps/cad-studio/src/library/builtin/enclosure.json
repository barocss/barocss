{
 "format": "barocss-cad-library",
 "version": 1,
 "id": "enclosure",
 "name": "Enclosure elements",
 "libraryVersion": "0.3.0",
 "units": "mm",
 "license": "CC0-1.0 (written for BaroCSS; legal review before release)",
 "provenance": "Written for BaroCSS from common plastic-design practice; no standard's or catalogue's text or tables. Every proportion is flagged an estimate: verify with your process (moulding or printing). Rule thresholds come from the material library's process profiles (D67).",
 "parts": [
  {
   "id": "screw-boss",
   "name": "Screw boss",
   "category": "enclosure",
   "simplified": true,
   "description": "A boss for a thread-forming screw, with four gussets: added to a wall or floor by its base.",
   "parameters": {
    "d": {
     "value": 3,
     "unit": "mm",
     "source": "the screw's nominal size (the variant's)",
     "description": "screw size"
    },
    "dp": {
     "value": 2.5,
     "unit": "mm",
     "estimate": true,
     "source": "BaroCSS rule of thumb for plastic bosses (written for this library, not from a standard or a catalogue); verify with your moulder or printer",
     "description": "pilot hole for a thread-forming screw"
    },
    "OD": {
     "value": {
      "expr": "2 * d + 0.4"
     },
     "unit": "mm",
     "description": "boss outer diameter"
    },
    "h": {
     "value": 8,
     "unit": "mm",
     "min": 2,
     "max": 60,
     "source": "free: the boss height"
    },
    "ribs": {
     "value": 4,
     "unit": "count",
     "integer": true,
     "min": 0,
     "max": 4,
     "source": "free: 0 or 4 gussets"
    },
    "rt": {
     "value": 1.0,
     "unit": "mm",
     "estimate": true,
     "source": "BaroCSS rule of thumb for plastic bosses (written for this library, not from a standard or a catalogue); verify with your moulder or printer",
     "description": "gusset thickness"
    },
    "rl": {
     "value": {
      "expr": "d + 1"
     },
     "unit": "mm",
     "description": "how far a gusset reaches out from the boss"
    },
    "rh": {
     "value": {
      "expr": "h * 0.75"
     },
     "unit": "mm",
     "description": "gusset height on the boss"
    },
    "r0": {
     "value": {
      "expr": "OD / 2 - 0.2"
     },
     "unit": "mm"
    }
   },
   "variants": [
    {
     "id": "M2",
     "values": {
      "d": 2,
      "dp": 1.6
     }
    },
    {
     "id": "M2.5",
     "values": {
      "d": 2.5,
      "dp": 2.0
     }
    },
    {
     "id": "M3",
     "values": {
      "d": 3,
      "dp": 2.5
     }
    },
    {
     "id": "M4",
     "values": {
      "d": 4,
      "dp": 3.3
     }
    },
    {
     "id": "M5",
     "values": {
      "d": 5,
      "dp": 4.2
     }
    }
   ],
   "context": {
    "wall": {
     "unit": "mm",
     "description": "the nominal wall of the body it is added to",
     "from": [
      "min_wall",
      "given"
     ]
    },
    "ribRec": {
     "unit": "ratio",
     "description": "the process's recommended rib-to-wall ratio",
     "from": [
      "profile.ribRec"
     ]
    },
    "ribMax": {
     "unit": "ratio",
     "description": "the process's largest rib-to-wall ratio",
     "from": [
      "profile.ribMax"
     ]
    },
    "bossWallMin": {
     "unit": "ratio",
     "description": "the process's least boss-wall-to-wall ratio",
     "from": [
      "profile.bossWallMin"
     ]
    },
    "bossWallMax": {
     "unit": "ratio",
     "description": "the process's largest boss-wall-to-wall ratio",
     "from": [
      "profile.bossWallMax"
     ]
    }
   },
   "checks": [
    {
     "id": "boss-wall-thin",
     "expr": "(OD - dp) / 2 >= bossWallMin * wall",
     "value": "(OD - dp) / 2 / wall",
     "level": "recommended",
     "message": "the boss wall is thinner than the process recommends against the nominal wall (weak, hard to fill)"
    },
    {
     "id": "boss-wall-thick",
     "expr": "(OD - dp) / 2 <= bossWallMax * wall",
     "value": "(OD - dp) / 2 / wall",
     "level": "recommended",
     "message": "the boss wall is thicker than the process recommends against the nominal wall (sink marks, voids)"
    },
    {
     "id": "rib-sink",
     "expr": "ribs == 0 || rt <= ribRec * wall",
     "value": "rt / wall",
     "level": "recommended",
     "message": "a gusset thicker than the process recommends against the wall (sink marks)"
    },
    {
     "id": "rib-wall",
     "expr": "ribs == 0 || rt <= ribMax * wall",
     "value": "rt / wall",
     "level": "feasible",
     "message": "a gusset thicker than the process allows against the wall it stands on"
    },
    {
     "id": "engagement",
     "expr": "h - 0.6 >= 2 * d",
     "value": "(h - 0.6) / d",
     "level": "recommended",
     "message": "less than two screw diameters of thread engagement"
    }
   ],
   "recipe": [
    {
     "id": "s",
     "kind": "sketch",
     "profile": "circle",
     "center": [
      0,
      0
     ],
     "radius": {
      "expr": "OD / 2"
     }
    },
    {
     "id": "b",
     "kind": "extrude",
     "sketch": "s",
     "height": {
      "expr": "h"
     }
    },
    {
     "id": "bh",
     "kind": "hole",
     "target": "b",
     "center": [
      0,
      0
     ],
     "radius": {
      "expr": "dp / 2"
     },
     "depth": {
      "expr": "h - 0.6"
     }
    },
    {
     "id": "g0s",
     "kind": "sketch",
     "profile": "polygon",
     "points": [
      [
       {
        "expr": "r0"
       },
       0
      ],
      [
       {
        "expr": "r0 + rl"
       },
       0
      ],
      [
       {
        "expr": "r0"
       },
       {
        "expr": "rh"
       }
      ]
     ],
     "plane": {
      "origin": [
       {
        "expr": "-0.0 * rt / 2"
       },
       {
        "expr": "1.0 * rt / 2"
       },
       0
      ],
      "normal": [
       0.0,
       -1.0,
       0.0
      ],
      "xAxis": [
       1.0,
       0.0,
       0.0
      ]
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g0x",
     "kind": "extrude",
     "sketch": "g0s",
     "height": {
      "expr": "rt"
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g0u",
     "kind": "union",
     "target": "bh",
     "tool": "g0x",
     "when": "ribs >= 4"
    },
    {
     "id": "g1s",
     "kind": "sketch",
     "profile": "polygon",
     "points": [
      [
       {
        "expr": "r0"
       },
       0
      ],
      [
       {
        "expr": "r0 + rl"
       },
       0
      ],
      [
       {
        "expr": "r0"
       },
       {
        "expr": "rh"
       }
      ]
     ],
     "plane": {
      "origin": [
       {
        "expr": "-1.0 * rt / 2"
       },
       {
        "expr": "0.0 * rt / 2"
       },
       0
      ],
      "normal": [
       1.0,
       0.0,
       0.0
      ],
      "xAxis": [
       0.0,
       1.0,
       0.0
      ]
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g1x",
     "kind": "extrude",
     "sketch": "g1s",
     "height": {
      "expr": "rt"
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g1u",
     "kind": "union",
     "target": "g0u",
     "tool": "g1x",
     "when": "ribs >= 4"
    },
    {
     "id": "g2s",
     "kind": "sketch",
     "profile": "polygon",
     "points": [
      [
       {
        "expr": "r0"
       },
       0
      ],
      [
       {
        "expr": "r0 + rl"
       },
       0
      ],
      [
       {
        "expr": "r0"
       },
       {
        "expr": "rh"
       }
      ]
     ],
     "plane": {
      "origin": [
       {
        "expr": "-0.0 * rt / 2"
       },
       {
        "expr": "-1.0 * rt / 2"
       },
       0
      ],
      "normal": [
       0.0,
       1.0,
       0.0
      ],
      "xAxis": [
       -1.0,
       0.0,
       0.0
      ]
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g2x",
     "kind": "extrude",
     "sketch": "g2s",
     "height": {
      "expr": "rt"
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g2u",
     "kind": "union",
     "target": "g1u",
     "tool": "g2x",
     "when": "ribs >= 4"
    },
    {
     "id": "g3s",
     "kind": "sketch",
     "profile": "polygon",
     "points": [
      [
       {
        "expr": "r0"
       },
       0
      ],
      [
       {
        "expr": "r0 + rl"
       },
       0
      ],
      [
       {
        "expr": "r0"
       },
       {
        "expr": "rh"
       }
      ]
     ],
     "plane": {
      "origin": [
       {
        "expr": "1.0 * rt / 2"
       },
       {
        "expr": "-0.0 * rt / 2"
       },
       0
      ],
      "normal": [
       -1.0,
       0.0,
       0.0
      ],
      "xAxis": [
       0.0,
       -1.0,
       0.0
      ]
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g3x",
     "kind": "extrude",
     "sketch": "g3s",
     "height": {
      "expr": "rt"
     },
     "when": "ribs >= 4"
    },
    {
     "id": "g3u",
     "kind": "union",
     "target": "g2u",
     "tool": "g3x",
     "when": "ribs >= 4"
    }
   ],
   "outputs": [
    "g3u"
   ],
   "interfaces": [
    {
     "id": "base",
     "role": "boss-base",
     "accepts": [
      "body-face"
     ],
     "frame": {
      "origin": [
       0,
       0,
       0
      ],
      "z": [
       0,
       0,
       -1
      ],
      "x": [
       1,
       0,
       0
      ]
     },
     "faces": {
      "plane": "b.bottom"
     },
     "description": "its foot, on the face it is added to"
    },
    {
     "id": "screw",
     "role": "screw-hole",
     "accepts": [
      "screw"
     ],
     "frame": {
      "origin": [
       0,
       0,
       {
        "expr": "h"
       }
      ],
      "z": [
       0,
       0,
       1
      ],
      "x": [
       1,
       0,
       0
      ]
     },
     "faces": {
      "axis": "bh.side0"
     }
    }
   ],
   "tags": [
    "enclosure",
    "boss",
    "screw"
   ]
  },
  {
   "id": "insert-hole",
   "name": "Heat-set insert hole",
   "category": "enclosure",
   "operation": "cut",
   "description": "The hole a brass heat-set insert is pressed into: cut from a boss or a wall at a point on its face.",
   "parameters": {
    "d": {
     "value": 3,
     "unit": "mm",
     "source": "the screw's nominal size (the variant's)",
     "description": "screw size"
    },
    "dh": {
     "value": 4.0,
     "unit": "mm",
     "estimate": true,
     "source": "written for this library as a typical brass heat-set insert for plastics (no supplier's table copied); use your insert's own datasheet",
     "description": "hole diameter"
    },
    "Lh": {
     "value": 5.0,
     "unit": "mm",
     "estimate": true,
     "source": "written for this library as a typical brass heat-set insert for plastics (no supplier's table copied); use your insert's own datasheet",
     "description": "hole depth"
    },
    "De": {
     "value": 4.6,
     "unit": "mm",
     "estimate": true,
     "source": "written for this library as a typical brass heat-set insert for plastics (no supplier's table copied); use your insert's own datasheet",
     "description": "the insert's outer diameter"
    }
   },
   "variants": [
    {
     "id": "M2",
     "values": {
      "d": 2,
      "dh": 3.2,
      "Lh": 4.0,
      "De": 3.6
     }
    },
    {
     "id": "M2.5",
     "values": {
      "d": 2.5,
      "dh": 3.6,
      "Lh": 4.6,
      "De": 4.0
     }
    },
    {
     "id": "M3",
     "values": {
      "d": 3,
      "dh": 4.0,
      "Lh": 5.0,
      "De": 4.6
     }
    },
    {
     "id": "M4",
     "values": {
      "d": 4,
      "dh": 5.6,
      "Lh": 6.6,
      "De": 6.3
     }
    },
    {
     "id": "M5",
     "values": {
      "d": 5,
      "dh": 6.4,
      "Lh": 7.5,
      "De": 7.1
     }
    }
   ],
   "context": {
    "depth": {
     "unit": "mm",
     "description": "the material under the point, along the hole",
     "from": [
      "measured",
      "given"
     ]
    },
    "around": {
     "unit": "mm",
     "description": "the least material round the hole's axis, halfway down",
     "from": [
      "measured",
      "given"
     ]
    }
   },
   "checks": [
    {
     "id": "breaks-through",
     "expr": "depth >= Lh + 0.4",
     "value": "depth - Lh",
     "level": "feasible",
     "message": "the hole would leave less than 0.4 mm under it, or break through"
    },
    {
     "id": "wall-round",
     "expr": "around - dh / 2 >= 0.8",
     "value": "around - dh / 2",
     "level": "feasible",
     "message": "less than 0.8 mm of material round the insert"
    },
    {
     "id": "boss-size",
     "expr": "around >= De",
     "value": "around / De",
     "level": "recommended",
     "message": "the boss round an insert should reach about twice its diameter across"
    }
   ],
   "recipe": [
    {
     "id": "s",
     "kind": "sketch",
     "profile": "circle",
     "center": [
      0,
      0
     ],
     "radius": {
      "expr": "dh / 2"
     }
    },
    {
     "id": "x",
     "kind": "extrude",
     "sketch": "s",
     "height": {
      "expr": "Lh + 1"
     },
     "from": -1
    }
   ],
   "interfaces": [
    {
     "id": "base",
     "role": "cut-base",
     "accepts": [
      "body-face"
     ],
     "frame": {
      "origin": [
       0,
       0,
       0
      ],
      "z": [
       0,
       0,
       1
      ],
      "x": [
       1,
       0,
       0
      ]
     },
     "description": "its mouth on the face, the hole going in along +z"
    },
    {
     "id": "insert",
     "role": "insert-axis",
     "accepts": [
      "screw"
     ],
     "frame": {
      "origin": [
       0,
       0,
       0
      ],
      "z": [
       0,
       0,
       -1
      ],
      "x": [
       1,
       0,
       0
      ]
     },
     "faces": {
      "axis": "x.side0"
     }
    }
   ],
   "tags": [
    "enclosure",
    "insert",
    "heat-set"
   ]
  },
  {
   "id": "pcb-standoff",
   "name": "PCB standoff",
   "category": "enclosure",
   "simplified": true,
   "description": "A standoff a board is screwed to: added to a floor by its base, the board on its top.",
   "parameters": {
    "d": {
     "value": 2.5,
     "unit": "mm",
     "source": "the screw's nominal size (the variant's)",
     "description": "screw size"
