{
  "name": "monorepo-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter barocss-docs docs:dev",
    "build": "pnpm --filter barocss-docs docs:build",
    "serve": "pnpm --filter barocss-docs docs:serve",
    "preview": "pnpm --filter barocss-docs docs:preview",
    "build:library": "pnpm run -r build:library",
    "test": "pnpm run -r test",
    "lint": "pnpm run -r lint",
    "type-check": "pnpm run -r type-check",
    "test:shadow-parity": "node scripts/shadow-parity/run.mjs",
    "check": "pnpm type-check && pnpm lint && pnpm build:library && pnpm test",
    "changeset:version": "pnpm changeset version && pnpm install --lockfile-only",
    "changeset:publish": "pnpm changeset publish",
    "dev:cad": "pnpm --filter @barocss/cad-studio-app dev",
    "dev:gpu": "node examples/gpu-scene/source-server.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.35.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.3.1"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.30.0",
      "cmdk>@radix-ui/react-primitive": "2.1.11"
    }
  }
}
