     "when": "ribs >= 4"
    }
   ],
   "outputs": [
    "g3u"
   ],
   "interfaces": [
    {
     "id": "base",
     "role": "boss-base",
     "accepts": [
      "body-face"
     ],
     "frame": {
      "origin": [
       0,
       0,
       0
      ],
      "z": [
       0,
       0,
       -1
      ],
      "x": [
       1,
       0,
       0
      ]
     },
     "faces": {
      "plane": "b.bottom"
     },
     "description": "its foot, on the face it is added to"
    },
    {
     "id": "screw",
     "role": "screw-hole",
     "accepts": [
      "screw"
     ],
     "frame": {
      "origin": [
       0,
       0,
       {
        "expr": "h"
       }
      ],
      "z": [
       0,
       0,
       1
      ],
      "x": [
       1,
